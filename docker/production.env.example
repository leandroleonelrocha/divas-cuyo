# Copiar a /srv/divas-cuyo/.env en el servidor y completar. NUNCA commitear el .env real.
# Valores entre comillas simples se toman literales (necesario para hashes con "$").

# --- Caddy / dominio ---
APP_DOMAIN=divas.verticedigital.com.ar
# staging = pide contraseña + noindex. public = sitio abierto.
SITE_PROFILE=staging
BASIC_AUTH_USER=divas
# Generar con: docker run --rm caddy:2 caddy hash-password --plaintext 'la-contraseña'
BASIC_AUTH_HASH='$2a$14$reemplazar.por.el.hash.generado'

# --- Laravel ---
APP_NAME="Divas Cuyo"
APP_ENV=production
# Generar UNA sola vez (ver docs/deploy-produccion.md) y no volver a cambiarla.
APP_KEY=
APP_DEBUG=false
APP_URL=https://divas.verticedigital.com.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de datos (MariaDB en el contenedor "db") ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=divas_cuyo
DB_USERNAME=divas
# Generar con: openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
IDENTITY_DOCUMENT_DISK=identity_private
QUEUE_CONNECTION=database
CACHE_STORE=database

# Las migraciones las corre deploy.sh antes de levantar la versión nueva.
AUTO_MIGRATE=false

# --- Mail (SMTP real: sin esto no llegan los mails de verificación) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@divas.verticedigital.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin inicial (php artisan admin:create --from-env) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Aviso legal ---
LEGAL_DISCLAIMER_VERSION=1
LEGAL_ACCEPTANCE_DAYS=30
LEGAL_COOKIE_SECURE=true

# --- Videos ---
MODEL_VIDEOS_PROVIDER=local
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
